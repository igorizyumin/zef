# Doxygen configuration for the public Z Event Framework (ZEF) API.
PROJECT_NAME           = "Z Event Framework (ZEF)"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "Fixed-memory actor and state-machine runtime"

INPUT                  = include ports/arm-cm0p docs/introduction.md
FILE_PATTERNS          = *.h *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build*/*
STRIP_FROM_PATH        = include ports/arm-cm0p

OUTPUT_DIRECTORY       = docs/doxygen
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
USE_MDFILE_AS_MAINPAGE = docs/introduction.md

EXTRACT_ALL            = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
WARN_LOGFILE           = docs/doxygen/doxygen-warnings.log

QUIET                  = NO
SEARCHENGINE           = YES
SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
